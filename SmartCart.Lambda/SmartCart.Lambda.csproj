<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      FIX: PublishAot removed — Google.Cloud.Functions.Framework and
      Google.Cloud.Monitoring.V3 are not AOT-safe; AOT is only compatible
      with the AWS Lambda project. Enable per-function in a publish profile
      for CartTelemetryProcessor.cs only if required.
    -->
    <AssemblyName>SmartCart.Lambda</AssemblyName>
    <RootNamespace>SmartCart.Lambda</RootNamespace>
    <Authors>soumya2310</Authors>
    <Company>Biju Patnaik University of Technology</Company>
    <Copyright>Copyright © 2025 Soumya Chattopadhyay</Copyright>
    <Description>AI Shopping Cart — Serverless analytics: AWS Lambda (DynamoDB Streams), Azure Functions (EventHub), GCP Cloud Functions (Pub/Sub)</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- AWS Lambda -->
    <PackageReference Include="Amazon.Lambda.Core"                             Version="2.*"   />
    <PackageReference Include="Amazon.Lambda.DynamoDBEvents"                   Version="3.*"   />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson"     Version="2.*"   />
    <PackageReference Include="AWSSDK.DynamoDBv2"                              Version="3.7.*" />
    <PackageReference Include="AWSSDK.CloudWatch"                              Version="3.7.*" />
    <!-- Azure Functions v4 Isolated Worker — AuthorizationLevel lives here -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker"               Version="1.22.*"/>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.EventHubs" Version="6.*" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http"      Version="3.*" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer"     Version="4.*" />
    <PackageReference Include="Microsoft.Azure.Cosmos"                         Version="3.38.*"/>
    <PackageReference Include="Azure.Data.Tables"                              Version="12.*"  />
    <!-- GCP Cloud Functions -->
    <PackageReference Include="Google.Cloud.Functions.Framework"               Version="2.2.*" />
    <PackageReference Include="Google.Cloud.Firestore"                         Version="3.7.*" />
    <PackageReference Include="Google.Cloud.Monitoring.V3"                     Version="3.9.*" />
    <!--
      FIX CS0246 — Google.Api.Metric and Google.Api.MonitoredResource live in
      Google.Api.CommonProtos. Although it is a transitive dependency of
      Google.Cloud.Monitoring.V3, listing it explicitly guarantees the types
      are resolvable and prevents version-resolution surprises.
    -->
    <PackageReference Include="Google.Api.CommonProtos"                        Version="2.15.*"/>
    <!--
      FIX CS0246 — ProjectName (resource-name helper) lives in
      Google.Api.Gax.ResourceNames, which is transitively pulled in by
      Google.Cloud.Monitoring.V3 but listed explicitly here for clarity.
    -->
    <PackageReference Include="Google.Api.Gax"                                 Version="4.9.*" />
    <!-- Shared -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"      Version="8.*"   />
  </ItemGroup>
</Project>
